# ==========================================
# BSP Suryatech — Hostinger Apache SPA Router URL Rewriter
# Ensures React Router can refresh pages (History API) and never blocks API routes
# ==========================================

# STRICT SECURITY: Deny public access to database backups, schemas, credentials, and configuration files
<FilesMatch "^\.|\.(sql|db|json|md|log|env|yml|yaml|sh|key)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow high payload execution headers (Ideal for EXE and PDF manual retrievals)
  <IfModule mod_env_module>
    SetEnv LimitRequestLine 32768
  </IfModule>

  # Prevent Directory Indexing Listings
  Options -Indexes

  # Avoid rewriting files if they exist on disc
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Auto-fallback: If requested as /downloads/FILENAME but uploaded directly to root, serve it
  RewriteCond %{DOCUMENT_ROOT}/$1 -f
  RewriteRule ^downloads/(.+)$ /$1 [L]

  # Auto-fallback: If folder on disk is named Downloads/ (capital D), serve from Downloads/
  RewriteCond %{DOCUMENT_ROOT}/Downloads/$1 -f
  RewriteRule ^downloads/(.+)$ /Downloads/$1 [L]

  # Auto-fallback: If requested as /downloads/FILENAME but uploaded to uploads/, serve it
  RewriteCond %{DOCUMENT_ROOT}/uploads/$1 -f
  RewriteRule ^downloads/(.+)$ /uploads/$1 [L]

  # Avoid rewriting directories if they exist on disc (except exactly /downloads page)
  RewriteCond %{REQUEST_URI} !^/downloads/?$ [NC]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # EXEMPTION RUNS: Prevent Apache from intercepting /api, /uploads, /sitemap.xml, or /robots.txt
  RewriteCond %{REQUEST_URI} ^/api [NC,OR]
  RewriteCond %{REQUEST_URI} ^/uploads [NC,OR]
  RewriteCond %{REQUEST_URI} ^/sitemap\.xml [NC,OR]
  RewriteCond %{REQUEST_URI} ^/robots\.txt [NC]
  RewriteRule ^ - [L]

  # SPA ROUTER REDIRECTION: Route all SPA client-side requests back to index.html
  RewriteRule . /index.html [L]
</IfModule>
